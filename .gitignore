# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
.venv*/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Azure Developer CLI ---
.azure/

# --- References = local context store (raw docs + distilled context.md + examples).
#     May hold confidential customer material. Contents are never committed,
#     but the folder's README scaffolding ships with the template. ---
references/*
!references/README.md
!references/docs/
references/docs/*
!references/docs/README.md

# --- Local agent run artifacts ---
conversations/
*.log

# --- OS / IDE ---
.DS_Store
.vscode/settings.json
